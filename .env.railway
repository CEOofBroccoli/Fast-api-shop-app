# Railway Environment Variables
# Copy these values to your Railway project settings

# === REQUIRED: Database Configuration ===
# Railway will auto-generate this when you add PostgreSQL service
DATABASE_URL=${PGDATABASE_URL}

# === REQUIRED: JWT Configuration ===
# Generate a secure secret key (min 32 characters)
JWT_SECRET_KEY=your-railway-production-jwt-secret-key-should-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === REQUIRED: Application Settings ===
ENVIRONMENT=production
DEBUG=false

# === OPTIONAL: Redis Cache ===
# Railway will auto-generate this when you add Redis service
REDIS_URL=${REDIS_URL}

# === OPTIONAL: Email Configuration ===
# Configure these if you want email functionality
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com

# === OPTIONAL: Shop Customization ===
# Override default shop settings
SHOP_NAME=Your Shop Name
SHOP_DESCRIPTION=Your shop description
SHOP_EMAIL=contact@yourshop.com
SHOP_PHONE=+1-234-567-8900
SHOP_WEBSITE=https://yourshop.com
SHOP_ADDRESS=Your shop address

# === SYSTEM VARIABLES (Auto-configured by Railway) ===
# These are set automatically by Railway
PORT=${PORT}
RAILWAY_ENVIRONMENT=production
